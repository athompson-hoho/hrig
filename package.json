{
  "name": "hrig",
  "version": "0.6.0",
  "private": true,
  "description": "A graphical Windows workspace for OpenRig",
  "main": "electron/main.cjs",
  "author": "HRig",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "icons": "node scripts/icons.mjs",
    "format": "prettier --write src electron tests scripts *.ts *.json index.html",
    "test:package": "node scripts/smoke-package.mjs",
    "test:dev": "node scripts/smoke-dev.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "flexlayout-react": "^0.11.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "dev.hrig.desktop",
    "productName": "HRig",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "npmRebuild": false
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "license": "UNLICENSED"
}
