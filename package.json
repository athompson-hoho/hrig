{
  "name": "hrig",
  "version": "0.9.0",
  "private": true,
  "description": "A graphical desktop workspace for OpenRig",
  "main": "electron/main.cjs",
  "author": "HRig",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "icons": "node scripts/icons.mjs",
    "format": "prettier --write src electron tests scripts *.ts *.json index.html",
    "test:package": "node scripts/smoke-package.mjs",
    "test:dev": "node scripts/smoke-dev.mjs",
    "mobile:build": "tsc --noEmit && vite build --config vite.mobile.config.ts",
    "mobile:gateway": "node electron/mobile-gateway.cjs",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "test:mobile": "npm run mobile:build && playwright test --config playwright.mobile.config.ts",
    "release:publish": "node scripts/publish-release.mjs",
    "test:install": "node scripts/smoke-install.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "8.4.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "flexlayout-react": "^0.11.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.56.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.hrig.desktop",
    "productName": "HRig",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/icon.png",
      "assets/theme-licenses/**/*",
      "THEME_CREDITS.md"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "HRig-${version}-macos-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz",
        "deb",
        "rpm"
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "artifactName": "HRig-${version}-linux-${arch}.${ext}",
      "maintainer": "HRig contributors <athompson-hoho@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HRig",
      "uninstallDisplayName": "HRig",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "artifactName": "HRig-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "HRig-${version}-windows-${arch}-portable.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/athompson-hoho/hrig/releases/latest/download"
    },
    "extraResources": [
      {
        "from": "release/policy.json",
        "to": "release-policy.json"
      }
    ]
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/athompson-hoho/hrig"
}
